# Copy to .env and fill in.
# .env is gitignored.

# Paste your Anthropic key here.
ANTHROPIC_API_KEY=

# Set after running `python -m stale.setup_agents`.
# These IDs are persistent — created once, reused across runs.
# Do NOT put inline comments on these lines: python-dotenv parses everything
# after the `=` (whitespace + `#` + comment) as the literal value, which
# breaks `os.environ.get(...)` checks.
STALE_ENVIRONMENT_ID=

# Phase 1 of the audit pipeline (Extractor — Sonnet 4.6, high-recall surfacing)
STALE_AUDITOR_AGENT_ID=

# Phase 2 of the audit pipeline (Adjudicator — Opus 4.7, FLAG/SKIP + citations)
STALE_ADJUDICATOR_AGENT_ID=

STALE_MARKET_FIT_AGENT_ID=
STALE_TOPICS_AGENT_ID=
